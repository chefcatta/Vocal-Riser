<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Chef Riser</title>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <!-- solo in Macintosh HD > Libreria (per tutti gli utenti), mai nella Libreria dell'utente -->
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="chefriser"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="chefriser" visible="false">
        <pkg-ref id="com.chefcatta.chefriser.pkg"/>
    </choice>
    <pkg-ref id="com.chefcatta.chefriser.pkg" version="VERSION" onConclusion="none">ChefRiser-core.pkg</pkg-ref>
</installer-gui-script>
